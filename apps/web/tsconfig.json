{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "extends": "../../tsconfig.base.json",
  "include": ["src", "*.ts"],
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@cloudflare/workers-types"],
    "paths": {
      "#/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/atom-react",
          "effect/http/Cookies#empty",
          "effect/http/Cookies#getValue",
          "effect/http/FetchHttpClient#RequestInit",
          "effect/http/FetchHttpClient#layer",
          "effect/http/HttpClient#followRedirects",
          "effect/http/HttpClient#withCookiesRef",
          "effect/http/HttpClientRequest#HttpClientRequest",
          "effect/http/HttpClientRequest#bodyUrlParams",
          "effect/http/HttpClientRequest#get",
          "effect/http/HttpClientRequest#post",
          "effect/http/HttpClientResponse#HttpClientResponse",
          "effect/http/HttpClient#HttpClient",
          "effect/http/HttpClientResponse#schemaBodyJson",
          "effect/reactivity/Atom"
        ]
      }
    ]
  }
}
